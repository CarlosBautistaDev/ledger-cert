# Ledger de Certificados de Conformidad — variables de entorno
# Copia este archivo a .env y ajusta los valores antes de 'make up'.
#   cp .env.example .env
#
# NUNCA commitees .env con valores reales (está en .gitignore).

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Genera una clave fuerte para producción, p.ej.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-insecure-change-me
# 1 = desarrollo (DEBUG on). 0 = producción.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,proxy
# Orígenes permitidos para CORS (la SPA se sirve same-origin tras Caddy).
CORS_ALLOWED_ORIGINS=https://localhost
# CSRF: el Django admin requiere el origen del proxy con su puerto.
CSRF_TRUSTED_ORIGINS=https://localhost:8443

# ---------------------------------------------------------------------------
# Frontend (build-time de Vite)
# ---------------------------------------------------------------------------
# La SPA habla con la API por ruta relativa: Caddy enruta /api -> api:8000.
VITE_API_URL=/api

# ---------------------------------------------------------------------------
# Seed inicial (management command seed_initial, idempotente)
# Crea el superusuario admin si no existe.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@ledger.local
ADMIN_PASSWORD=changeme-admin

# ---------------------------------------------------------------------------
# Zona horaria (los timestamps en DB se guardan en UTC).
# ---------------------------------------------------------------------------
TZ=UTC
